# Copy to .env on cooper and fill in. Never commit .env.
POSTGRES_PASSWORD=
# FREIGHTCORE's SOAP credentials, the ones Priya would hand you
FCWS_USER=LKSFWEB
FCWS_PASSWORD=
# Deskline API token used by the world and by your integrations
DESKLINE_TOKEN=
# Unlocks the sealed scenario. Paste it without opening anything it decrypts.
LARKSPUR_SCENARIO_KEY=
# 0.1 is a tenth of Larkspur's real volume
WORLD_SCALE=0.1
# Larkspur's own support agents answer tickets; set to off only if you want an empty queue
WORLD_AGENTS=on
